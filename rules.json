{
  "version": 2,
  "updated_at": "2026-10-31T20:13:20.186Z",
  "description": "Reglas de autodetección dinámicas para WatchlistPlus",
  "rules": [
    {
      "id": "cuevana3-hash-spa",
      "name": "Cuevana 3 SPA HashRouter",
      "domains": [
        "cuevana3.gs",
        "cuevana.be",
        "cuevana3.ch",
        "cuevana.pro",
        "cuevana3.eu",
        "cuevana.biz",
        "cuevana3.me",
        "cuevana.la"
      ],
      "regex": "#/serie/([^/]+)/temporada/(\\d+)/episodio/(\\d+)",
      "target": "hash",
      "slugGroup": 1,
      "seasonGroup": 2,
      "episodeGroup": 3
    },
    {
      "id": "animeflv-ver",
      "name": "AnimeFLV Capítulos",
      "domains": [
        "animeflv.net",
        "animeflv.to"
      ],
      "regex": "/ver/([^/]+)-(\\d+)$",
      "target": "path",
      "slugGroup": 1,
      "episodeGroup": 2
    },
    {
      "id": "tioanime-ver",
      "name": "TioAnime Capítulos",
      "domains": [
        "tioanime.com"
      ],
      "regex": "/ver/([^/]+)-(\\d+)$",
      "target": "path",
      "slugGroup": 1,
      "episodeGroup": 2
    },
    {
      "id": "generic-season-ep",
      "name": "Patrón Universal Temporada y Episodio",
      "domains": [
        "*"
      ],
      "regex": "(?:temporada|season|s)[-/]?(\\d+)[^/]+(?:capitulo|episodio|ep|episode)[-/]?(\\d+)",
      "target": "path",
      "seasonGroup": 1,
      "episodeGroup": 2
    }
  ]
}
